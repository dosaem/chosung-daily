FLASK_ENV=development
SECRET_KEY=dev-secret-key
DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily_test?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

# flask search-books / seed-books CLI에서만 쓰는 키. 둘 다 무료 발급.
# 카카오: https://developers.kakao.com (내 애플리케이션 > REST API 키)
# 알라딘: 알라딘 Open API(TTB) 페이지에서 신청
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인(계정 연결). 비워두면 그 provider의 로그인 버튼이
# OAUTH_PROVIDER_UNAVAILABLE(503)로 막힌다 — 둘 다 선택사항.
# 구글: console.cloud.google.com > OAuth 클라이언트 ID(웹 애플리케이션),
#   승인된 리디렉션 URI에 <BASE_URL>/api/v1/auth/google/callback 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 애플: Apple Developer 계정(유료) 필요. Services ID를 만들고 "Sign in with
# Apple" 활성화, Return URL에 <BASE_URL>/api/v1/auth/apple/callback 등록.
# client_secret은 고정값이 아니라 APPLE_PRIVATE_KEY로 서명한 JWT를 서버가
# 직접 만든다(app/extensions.py의 _apple_client_secret) — 아래 세 값은
# "Sign in with Apple" 키를 만들 때 같이 발급됨.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용을 그대로 붙여넣되, 줄바꿈은 "\n" 문자로 (예: "-----BEGIN
# PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----")
APPLE_PRIVATE_KEY=

# 운영자 알림(단어 잔량·퍼즐 배정 실패·백업 실패)을 받을 Slack Incoming Webhook URL.
# Slack 앱 > Incoming Webhooks 에서 채널 하나를 골라 발급. 비워두면 알림을 보내지
# 않는다(개발 기본값). 설정 후 `uv run flask notify-operator-test` 로 확인.
SLACK_WEBHOOK_URL=

# [02] 마이그레이션 왕복 테스트(tests/test_migrations.py)가 쓸 별도 DB.
# 안 넣으면 TEST_DATABASE_URL 의 DB 이름 + "_migrations" 를 쓴다. 만드는 방법은
# README "실행 방법" 참고 — 테스트 유저에겐 CREATE DATABASE 권한이 없다.
TEST_MIGRATION_DATABASE_URL=

# 앱(네이티브) 로그인 — POST /api/v1/auth/token-exchange 가 id_token 의 aud 로
# 받아들일 값들(ADR 0002 의 aud 매트릭스). 비워두면 그 경로 로그인은 전부
# INVALID_ID_TOKEN 이다(설정 누락이 "검증 없이 통과" 가 되지 않게 한 선택).
# 구글 iOS: GCP 에 iOS 용 OAuth 클라이언트 ID 를 따로 만들어 그 값을 넣는다.
# 구글 Android: 앱이 serverClientId 로 넘기는 "웹" 클라이언트 ID(= GOOGLE_CLIENT_ID
#   와 같은 값이어도 된다). Android 클라이언트 ID 는 SHA-1 검증용이라 aud 에 안 온다.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# 애플 iOS 앱 로그인용 번들 ID(예: com.dosaem.chosung). 웹은 Services ID
# (APPLE_CLIENT_ID), 앱은 이 번들 ID 가 aud 로 오고 client_secret(JWT)도 이 값으로
# 서명해야 애플 토큰 엔드포인트가 받아준다. 서명 키는 웹과 같은 것을 쓴다 —
# APPLE_TEAM_ID·APPLE_KEY_ID·APPLE_PRIVATE_KEY 를 그대로 재사용하므로 앱용으로
# .p8 키를 또 발급할 필요는 없다(Sign in with Apple 키 하나가 App ID 와 그
# Services ID 를 모두 서명한다). 미정 17 반영.
# (서명 함수는 app/extensions.py 의 apple_client_secret(app, client_id) — 이 티켓에서
#  client_id 를 인자로 받게 바꿔 웹 Services ID 와 앱 번들 ID 를 모두 서명한다.)
APPLE_APP_BUNDLE_ID=
# [08] 스토어 링크 — `GET /api/v1/config` 의 store_urls 와 웹 Smart App Banner
# (티켓 18)가 같은 값을 쓴다. 스토어에 앱을 올리기 전에는 비워둔다(응답에 null).
# APP_STORE_ID 는 App Store 숫자 ID 로, Smart App Banner 메타 태그에만 쓴다.
STORE_URL_IOS=
STORE_URL_ANDROID=
APP_STORE_ID=

# [08] Sentry. 비워두면 Sentry 를 아예 초기화하지 않는다(개발·테스트 기본값).
# sentry.io 프로젝트의 DSN 을 그대로 넣는다 — 백엔드·Flutter 프로젝트가 따로다.
# SENTRY_RELEASE 는 이벤트에 붙는 릴리스 태그로, 배포 스크립트가 배포한 커밋
# 해시를 넣는다. 수동으로 띄울 때는 비워둬도 된다(환경 태그만 붙음).
SENTRY_DSN=
SENTRY_RELEASE=

# [09] 법적 문서(/privacy, /terms)에 싣는 공개 정보.
# 연락처는 비워두면 운영자 주소(hsseo@dosaem.com)가 기본값이다 — 스토어 콘솔·Play
# Data safety 양식에 적는 주소와 같아야 한다.
LEGAL_CONTACT_EMAIL=
# 사업자 정보. 값이 있는 항목만 두 문서의 "운영자 정보" 블록에 나오고, 전부 비면
# 서비스명과 연락처만 나온다. 실제 값은 사업자·통신판매업 등록 후 사람이 채운다
# (docs/RELEASE.md "### 09." 체크리스트). 주소·통신판매업 번호는 선택.
LEGAL_BUSINESS_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_BUSINESS_REG_NO=
LEGAL_MAIL_ORDER_REG_NO=
LEGAL_BUSINESS_ADDRESS=
# 16. 전화번호·보호책임자 성명은 비우면 표시하지 않는다(사용자 결정 2026-10-14).
# 주소는 축약해 넣을 수 있다 — 코드가 자르지 않는다. docs/legal-checklist.md §6
LEGAL_BUSINESS_PHONE=
LEGAL_PRIVACY_OFFICER=
# [12] 광고 제거 구독 검증(POST /subscriptions/verify). 비워두면 그 스토어의
# 검증이 STORE_UNAVAILABLE(503)로 막힌다 — 결제 없이 나머지 API 는 그대로 돈다.
# 상품 ID 는 양 스토어에 같은 이름으로 등록한다.
SUBSCRIPTION_PRODUCT_ID=adfree_monthly

# App Store Server API. App Store Connect > 사용자 및 액세스 > 통합 >
# In-App Purchase 키에서 .p8 과 KEY_ID 를 받고, 같은 화면의 Issuer ID 를 쓴다.
# 로그인용 "Sign in with Apple" 키(APPLE_* )와는 다른 키다.
APP_STORE_BUNDLE_ID=
# App Store Connect > 앱 > 앱 정보의 숫자 "Apple ID". 공식 검증기가 Production
# 환경에서 필수로 요구한다 — 비어 있으면 프로덕션 영수증 검증이 503 으로 막힌다.
APP_STORE_APP_APPLE_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# .p8 내용을 그대로 붙여넣되 줄바꿈은 "\n" 문자로 (APPLE_PRIVATE_KEY 와 같은 요령)
APP_STORE_PRIVATE_KEY=
# JWS 서명 체인 검증에 쓸 Apple Root CA 인증서(.cer, DER) 경로. Apple PKI
# 페이지(https://www.apple.com/certificateauthority/)에서 받아 서버에 두고
# 콤마로 나열한다 (예: /etc/apple/AppleRootCA-G3.cer)
APP_STORE_ROOT_CERT_PATHS=

# Google Play Developer API. Play Console > API 액세스에서 서비스 계정을 만들고
# "재무 데이터 보기" 권한을 준 뒤 JSON 키를 받아 서버에 두고 그 경로를 넣는다.
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_FILE=

# [15] 운영자 페이지(/admin)에 들어올 수 있는 구글 계정 이메일. 쉼표로 여러 개.
# **기본값이 없다** — 비워두면 아무도 운영자가 아니다(전부 403). 별도 비밀번호 없이
# 기존 구글 로그인 세션의 연결된 이메일로만 판정한다(README "설계 판단 15.").
# 운영 값은 운영자 계정 두 개다 (CONTEXT.md "운영자"):
#   ADMIN_EMAILS=dosaem90@gmail.com,hsseo@dosaem.com
ADMIN_EMAILS=

# [23] Google Books API 키 (영어 책 제목 검색, /admin/books). **선택**이다 —
# 비워두면 키 없이 호출하고 검색은 그대로 된다. 키를 넣으면 쿼터가 호출 IP 대신
# GCP 프로젝트에 붙는다(GCP 콘솔 > API 및 서비스 > Books API 사용 설정 후 API 키).
GOOGLE_BOOKS_API_KEY=

# [36] 개인정보 안전성 확보조치 — 백업 덤프 암호화와 접속기록 보관.
# 로컬 개발에서는 셋 다 필요 없다(백업·Gunicorn 은 prod compose 에서만 돈다).
# 운영 값과 생성 절차는 .env.prod.example 과 docs/RELEASE.md "### 36.".
#   BACKUP_ENCRYPTION_CERT_FILE : 덤프를 암호화할 수신자 공개키 인증서 경로.
#                                 비우면 backup.sh 가 덤프를 만들지 않고 실패한다.
#                                 복호화 개인키는 NAS 에 두지 않는다(restore.sh -k).
#   LOG_DIR                     : Gunicorn 접근 로그(접속기록)를 둘 호스트 폴더.
#   ACCESS_LOG_RETENTION_DAYS   : 접속기록 보관 기간(일). 기본 365 = 개인정보의
#                                 안전성 확보조치 기준 제8조 제1항의 법정 최소 1년.
BACKUP_ENCRYPTION_CERT_FILE=
LOG_DIR=
ACCESS_LOG_RETENTION_DAYS=

# [LLM 출제] 단어 잔량이 부족하면 LLM 이 후보를 만들어 어드민 승인 대기열에 올린다
# (README "운영: LLM 단어 후보"). 키는 이 프로젝트 전용으로 발급한다 — 다른
# 프로젝트 키를 같이 쓰면 비용 로그가 섞인다. 키가 비면 생성은 돌지 않고, 테스트는
# HTTP 경계를 mock 해서 돈다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_WORD_GENERATION_ENABLED=false
LLM_MONTHLY_BUDGET_USD=5
LLM_MAX_PENDING_CANDIDATES=60
LLM_CANDIDATES_PER_CALL=40

# [티켓 51] 에러 알림 자동화 — Sentry 내부 통합 웹훅(Client Secret)과 GitHub 이슈용 토큰.
# Sentry: Settings > Developer Settings > Internal Integration, webhook URL
#   https://<도메인>/api/v1/ops/sentry, 권한 Issue & Event: Read, Webhooks: issue + event alert.
# GitHub: fine-grained PAT, 이 레포 Issues: Read and write 만.
SENTRY_WEBHOOK_SECRET=
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=dosaem/chosung-daily
OPS_ISSUE_LABEL=sentry
