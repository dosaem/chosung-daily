FLASK_ENV=development
SECRET_KEY=dev-secret-key
DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily_test?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

# flask search-books / seed-books CLI에서만 쓰는 키. 둘 다 무료 발급.
# 카카오: https://developers.kakao.com (내 애플리케이션 > REST API 키)
# 알라딘: 알라딘 Open API(TTB) 페이지에서 신청
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인(계정 연결). 비워두면 그 provider의 로그인 버튼이
# OAUTH_PROVIDER_UNAVAILABLE(503)로 막힌다 — 둘 다 선택사항.
# 구글: console.cloud.google.com > OAuth 클라이언트 ID(웹 애플리케이션),
#   승인된 리디렉션 URI에 <BASE_URL>/api/v1/auth/google/callback 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 애플: Apple Developer 계정(유료) 필요. Services ID를 만들고 "Sign in with
# Apple" 활성화, Return URL에 <BASE_URL>/api/v1/auth/apple/callback 등록.
# client_secret은 고정값이 아니라 APPLE_PRIVATE_KEY로 서명한 JWT를 서버가
# 직접 만든다(app/extensions.py의 _apple_client_secret) — 아래 세 값은
# "Sign in with Apple" 키를 만들 때 같이 발급됨.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용을 그대로 붙여넣되, 줄바꿈은 "\n" 문자로 (예: "-----BEGIN
# PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----")
APPLE_PRIVATE_KEY=

# 운영자 알림(단어 잔량·퍼즐 배정 실패·백업 실패)을 받을 Slack Incoming Webhook URL.
# Slack 앱 > Incoming Webhooks 에서 채널 하나를 골라 발급. 비워두면 알림을 보내지
# 않는다(개발 기본값). 설정 후 `uv run flask notify-operator-test` 로 확인.
SLACK_WEBHOOK_URL=

# [02] 마이그레이션 왕복 테스트(tests/test_migrations.py)가 쓸 별도 DB.
# 안 넣으면 TEST_DATABASE_URL 의 DB 이름 + "_migrations" 를 쓴다. 만드는 방법은
# README "실행 방법" 참고 — 테스트 유저에겐 CREATE DATABASE 권한이 없다.
TEST_MIGRATION_DATABASE_URL=

# 앱(네이티브) 로그인 — POST /api/v1/auth/token-exchange 가 id_token 의 aud 로
# 받아들일 값들(ADR 0002 의 aud 매트릭스). 비워두면 그 경로 로그인은 전부
# INVALID_ID_TOKEN 이다(설정 누락이 "검증 없이 통과" 가 되지 않게 한 선택).
# 구글 iOS: GCP 에 iOS 용 OAuth 클라이언트 ID 를 따로 만들어 그 값을 넣는다.
# 구글 Android: 앱이 serverClientId 로 넘기는 "웹" 클라이언트 ID(= GOOGLE_CLIENT_ID
#   와 같은 값이어도 된다). Android 클라이언트 ID 는 SHA-1 검증용이라 aud 에 안 온다.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# 애플 iOS 앱 로그인용 번들 ID(예: com.dosaem.chosung). 웹은 Services ID
# (APPLE_CLIENT_ID), 앱은 이 번들 ID 가 aud 로 오고 client_secret(JWT)도 이 값으로
# 서명해야 애플 토큰 엔드포인트가 받아준다. 서명 키는 웹과 같은 것을 쓴다 —
# APPLE_TEAM_ID·APPLE_KEY_ID·APPLE_PRIVATE_KEY 를 그대로 재사용하므로 앱용으로
# .p8 키를 또 발급할 필요는 없다(Sign in with Apple 키 하나가 App ID 와 그
# Services ID 를 모두 서명한다). 미정 17 반영.
# (서명 함수는 app/extensions.py 의 apple_client_secret(app, client_id) — 이 티켓에서
#  client_id 를 인자로 받게 바꿔 웹 Services ID 와 앱 번들 ID 를 모두 서명한다.)
APPLE_APP_BUNDLE_ID=
# [08] 스토어 링크 — `GET /api/v1/config` 의 store_urls 와 웹 Smart App Banner
# (티켓 18)가 같은 값을 쓴다. 스토어에 앱을 올리기 전에는 비워둔다(응답에 null).
# APP_STORE_ID 는 App Store 숫자 ID 로, Smart App Banner 메타 태그에만 쓴다.
STORE_URL_IOS=
STORE_URL_ANDROID=
APP_STORE_ID=

# [08] Sentry. 비워두면 Sentry 를 아예 초기화하지 않는다(개발·테스트 기본값).
# sentry.io 프로젝트의 DSN 을 그대로 넣는다 — 백엔드·Flutter 프로젝트가 따로다.
# SENTRY_RELEASE 는 이벤트에 붙는 릴리스 태그로, 배포 스크립트가 배포한 커밋
# 해시를 넣는다. 수동으로 띄울 때는 비워둬도 된다(환경 태그만 붙음).
SENTRY_DSN=
SENTRY_RELEASE=

# [09] 법적 문서(/privacy, /terms)에 싣는 공개 정보.
# 연락처는 비워두면 운영자 주소(hsseo@dosaem.com)가 기본값이다 — 스토어 콘솔·Play
# Data safety 양식에 적는 주소와 같아야 한다.
LEGAL_CONTACT_EMAIL=
# 사업자 정보. 값이 있는 항목만 두 문서의 "운영자 정보" 블록에 나오고, 전부 비면
# 서비스명과 연락처만 나온다. 실제 값은 사업자·통신판매업 등록 후 사람이 채운다
# (docs/RELEASE.md "### 09." 체크리스트). 주소·통신판매업 번호는 선택.
LEGAL_BUSINESS_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_BUSINESS_REG_NO=
LEGAL_MAIL_ORDER_REG_NO=
LEGAL_BUSINESS_ADDRESS=
