FLASK_ENV=development
SECRET_KEY=dev-secret-key
DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://chosung:chosung@mysql:3306/chosung_daily_test?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1

# flask search-books / seed-books CLI에서만 쓰는 키. 둘 다 무료 발급.
# 카카오: https://developers.kakao.com (내 애플리케이션 > REST API 키)
# 알라딘: 알라딘 Open API(TTB) 페이지에서 신청
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인(계정 연결). 비워두면 그 provider의 로그인 버튼이
# OAUTH_PROVIDER_UNAVAILABLE(503)로 막힌다 — 둘 다 선택사항.
# 구글: console.cloud.google.com > OAuth 클라이언트 ID(웹 애플리케이션),
#   승인된 리디렉션 URI에 <BASE_URL>/api/v1/auth/google/callback 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 애플: Apple Developer 계정(유료) 필요. Services ID를 만들고 "Sign in with
# Apple" 활성화, Return URL에 <BASE_URL>/api/v1/auth/apple/callback 등록.
# client_secret은 고정값이 아니라 APPLE_PRIVATE_KEY로 서명한 JWT를 서버가
# 직접 만든다(app/extensions.py의 _apple_client_secret) — 아래 세 값은
# "Sign in with Apple" 키를 만들 때 같이 발급됨.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용을 그대로 붙여넣되, 줄바꿈은 "\n" 문자로 (예: "-----BEGIN
# PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----")
APPLE_PRIVATE_KEY=

# 운영자 알림(단어 잔량·퍼즐 배정 실패·백업 실패)을 받을 Slack Incoming Webhook URL.
# Slack 앱 > Incoming Webhooks 에서 채널 하나를 골라 발급. 비워두면 알림을 보내지
# 않는다(개발 기본값). 설정 후 `uv run flask notify-operator-test` 로 확인.
SLACK_WEBHOOK_URL=
