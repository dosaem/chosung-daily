# docker-compose.prod.yml의 develop 인스턴스 전용. NAS의
# /volume1/docker/chosung-daily-develop/.env.develop로 복사해서 쓴다 — 이 파일
# 자체는 예시일 뿐, 실제 값은 절대 커밋하지 않는다.
#
# 실행: docker compose -f docker-compose.prod.yml -p chosung-daily-develop \
#         --env-file .env.develop up -d --build
#
# prod와 다른 값은 아래 세 줄뿐이다 — 나머지 시크릿은 develop용으로 따로 발급하거나
# 비워둔다(비면 그 provider는 503).

# compose가 자동으로 읽는 파일은 .env뿐이라 develop은 --env-file이 필수다. 그래도
# COMPOSE_PROJECT_NAME을 여기 둬서, --env-file만 주고 `-p`를 빼도 프로젝트가
# chosung-daily-develop으로 고정되게 한다(새 볼륨 생성 사고 방지).
COMPOSE_PROJECT_NAME=chosung-daily-develop
# NAS 실측으로 확정(스펙 미정 8). prod 8089와 겹치면 안 된다.
APP_PORT=8090
ENV_FILE=.env.develop

SECRET_KEY=
SESSION_COOKIE_SECURE=true

# mysql 서비스의 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD와 같은 값이어야 한다.
# prod와 같은 비밀번호를 쓰지 않는다 — 볼륨은 분리돼 있어도 사고 반경을 줄인다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 책 검색 (flask search-books)
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인. 비워두면 그 provider는 503(OAUTH_PROVIDER_UNAVAILABLE).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

### 21. 매일 백업 (backup 서비스)
# prod 와 같은 폴더를 쓰면 덤프가 섞인다 — 인스턴스마다 다른 경로를 준다.
BACKUP_DIR=./backups-develop
# 백업 실패 알림용 Slack Incoming Webhook. 비워두면 알림만 생략된다.
SLACK_WEBHOOK_URL=

### 36. 개인정보 안전성 확보조치 (백업 암호화 · 접속기록)
# 백업 덤프를 암호화할 **수신자 공개키 인증서** 경로(컨테이너 안 경로). 비우면
# backup.sh 가 **덤프를 만들지 않고 실패**한다 — 평문으로 조용히 떨어지지 않게.
# 인증서는 BACKUP_DIR 안에 두면 이미 bind mount 돼 있어서 추가 마운트가 필요 없다.
# 복호화 개인키는 **NAS 에 두지 않는다**(복구할 때 restore.sh -k 로 넘긴다).
# 키 생성·보관·교체 절차: docs/RELEASE.md "### 36."
BACKUP_ENCRYPTION_CERT_FILE=/backups/backup-cert.pem
# Gunicorn 접근 로그(접속기록)를 둘 호스트 폴더. BACKUP_DIR 과 같은 방식으로
# bind mount 한다 — 컨테이너가 날아가도 보관 기간 동안 남아야 한다. 쓰기 불가면
# 앱이 기동하면서 죽는다(접속기록이 조용히 빠지는 쪽보다 낫다).
LOG_DIR=./logs-develop
# 접속기록 보관 기간(일). 비우면 365 — 개인정보의 안전성 확보조치 기준 제8조
# 제1항의 법정 최소 1년이다. 정보주체 5만명 이상이거나 고유식별정보·민감정보를
# 처리하게 되면 730 으로 올리고 방침 문구도 같이 고친다(docs/RELEASE.md "### 36.").
ACCESS_LOG_RETENTION_DAYS=365
