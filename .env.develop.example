# docker-compose.prod.yml의 develop 인스턴스 전용. NAS의
# /volume1/docker/chosung-daily-develop/.env.develop로 복사해서 쓴다 — 이 파일
# 자체는 예시일 뿐, 실제 값은 절대 커밋하지 않는다.
#
# 실행: docker compose -f docker-compose.prod.yml -p chosung-daily-develop \
#         --env-file .env.develop up -d --build
#
# prod와 다른 값은 아래 세 줄뿐이다 — 나머지 시크릿은 develop용으로 따로 발급하거나
# 비워둔다(비면 그 provider는 503).

# compose가 자동으로 읽는 파일은 .env뿐이라 develop은 --env-file이 필수다. 그래도
# COMPOSE_PROJECT_NAME을 여기 둬서, --env-file만 주고 `-p`를 빼도 프로젝트가
# chosung-daily-develop으로 고정되게 한다(새 볼륨 생성 사고 방지).
COMPOSE_PROJECT_NAME=chosung-daily-develop
# NAS 실측으로 확정(스펙 미정 8). prod 8089와 겹치면 안 된다.
APP_PORT=8090
ENV_FILE=.env.develop

SECRET_KEY=
SESSION_COOKIE_SECURE=true

# mysql 서비스의 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD와 같은 값이어야 한다.
# prod와 같은 비밀번호를 쓰지 않는다 — 볼륨은 분리돼 있어도 사고 반경을 줄인다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 책 검색 (flask search-books)
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인. 비워두면 그 provider는 503(OAUTH_PROVIDER_UNAVAILABLE).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

### 21. 매일 백업 (backup 서비스)
# prod 와 같은 폴더를 쓰면 덤프가 섞인다 — 인스턴스마다 다른 경로를 준다.
BACKUP_DIR=./backups-develop
# 백업 실패 알림용 Slack Incoming Webhook. 비워두면 알림만 생략된다.
SLACK_WEBHOOK_URL=
