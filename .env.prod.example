# docker-compose.prod.yml 전용. NAS의 /volume1/docker/chosung-daily/.env로
# 복사해서 쓴다 — 이 파일 자체는 예시일 뿐, 실제 값은 절대 커밋하지 않는다.

SECRET_KEY=
SESSION_COOKIE_SECURE=true

# mysql 서비스의 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD와 같은 값이어야 한다.
# docker-compose.prod.yml이 둘 다 이 변수로 치환해서 쓴다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 책 검색 (flask search-books)
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인. 비워두면 그 provider는 503(OAUTH_PROVIDER_UNAVAILABLE).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
