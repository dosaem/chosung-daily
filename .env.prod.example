# docker-compose.prod.yml의 prod 인스턴스 전용. NAS의
# /volume1/docker/chosung-daily/.env로 복사해서 쓴다 — 이 파일 자체는 예시일 뿐,
# 실제 값은 절대 커밋하지 않는다. develop은 .env.develop.example을 쓴다.
#
# 실행: docker compose -f docker-compose.prod.yml -p chosung-daily-prod \
#         --env-file .env up -d --build

# compose 프로젝트명·호스트 포트·컨테이너에 넣을 env 파일. compose가 프로젝트
# 디렉터리의 .env를 자동으로 읽기 때문에, `-p`를 빼고 up 해도 같은 프로젝트
# (= 같은 볼륨)에 붙는다 — 새 볼륨이 생겨 기록이 사라지는 사고를 막는 안전장치다.
# 프로젝트명을 바꾸면 기존 볼륨(chosung-daily-prod_mysql-data)이 안 붙는다.
COMPOSE_PROJECT_NAME=chosung-daily-prod
APP_PORT=8089
ENV_FILE=.env

SECRET_KEY=
SESSION_COOKIE_SECURE=true

# mysql 서비스의 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD와 같은 값이어야 한다.
# docker-compose.prod.yml이 둘 다 이 변수로 치환해서 쓴다.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 책 검색 (flask search-books)
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=

# 구글/애플 로그인. 비워두면 그 provider는 503(OAUTH_PROVIDER_UNAVAILABLE).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

### 21. 매일 백업 (backup 서비스)
# 덤프를 둘 호스트 폴더. compose 가 backup 컨테이너의 /backups 로 bind mount 하고
# 14일치 gzip 덤프가 쌓인다. NAS 에서는 체크아웃 밖의 공유 폴더를 권장
# (예: /volume1/backup/chosung-daily-prod) — 체크아웃을 지워도 덤프는 남는다.
BACKUP_DIR=./backups
# 백업 실패 알림용 Slack Incoming Webhook. 비워두면 알림만 생략된다.
SLACK_WEBHOOK_URL=

### 36. 개인정보 안전성 확보조치 (백업 암호화 · 접속기록)
# 백업 덤프를 암호화할 **수신자 공개키 인증서** 경로(컨테이너 안 경로). 비우면
# backup.sh 가 **덤프를 만들지 않고 실패**한다 — 평문으로 조용히 떨어지지 않게.
# 인증서는 BACKUP_DIR 안에 두면 이미 bind mount 돼 있어서 추가 마운트가 필요 없다.
# 복호화 개인키는 **NAS 에 두지 않는다**(복구할 때 restore.sh -k 로 넘긴다).
# 키 생성·보관·교체 절차: docs/RELEASE.md "### 36."
BACKUP_ENCRYPTION_CERT_FILE=/backups/backup-cert.pem
# Gunicorn 접근 로그(접속기록)를 둘 호스트 폴더. BACKUP_DIR 과 같은 방식으로
# bind mount 한다 — 컨테이너가 날아가도 보관 기간 동안 남아야 한다. 쓰기 불가면
# 앱이 기동하면서 죽는다(접속기록이 조용히 빠지는 쪽보다 낫다).
LOG_DIR=./logs
# 접속기록 보관 기간(일). 비우면 365 — 개인정보의 안전성 확보조치 기준 제8조
# 제1항의 법정 최소 1년이다. 정보주체 5만명 이상이거나 고유식별정보·민감정보를
# 처리하게 되면 730 으로 올리고 방침 문구도 같이 고친다(docs/RELEASE.md "### 36.").
ACCESS_LOG_RETENTION_DAYS=365
