#!/bin/sh
# 가짜 docker — compose 질의에 답하고 호출을 기록한다.
printf 'docker %s\n' "$*" >> "$FAKE_LOG"

# 진짜 `docker compose exec -T`·`run -T` 는 표준입력을 컨테이너로 흘려보낸다(`-T` 는
# TTY 만 끈다). 스크립트를 `bash -s` 로 표준입력에서 읽히면 이게 아직 안 읽힌 스크립트
# 본문을 먹어버리므로(D-20-4), 가짜도 똑같이 stdin 을 끝까지 읽는다.
# 호출하는 쪽은 stdin 을 반드시 닫거나 넘긴다 — 터미널에 붙은 채로 부르면 멈춘다.
case "$*" in
  *"exec -T"*|*"run --rm"*) cat > /dev/null ;;
esac

if [ -n "${FAKE_DOCKER_FAIL:-}" ]; then
  case "$*" in
    *"$FAKE_DOCKER_FAIL"*) echo "fake docker: $FAKE_DOCKER_FAIL 실패" >&2; exit 1 ;;
  esac
fi

case "$*" in
  *"config --services"*)
    for s in ${FAKE_DOCKER_SERVICES:-mysql redis app proxy worker beat}; do echo "$s"; done ;;
  *"ps --services"*)
    for s in ${FAKE_DOCKER_RUNNING:-mysql redis app proxy worker beat}; do echo "$s"; done ;;
  *"ps --status running -q app"*)
    # 롤링 교체: `--scale` 로 새 컨테이너를 띄운 뒤에는 새 id 가 같이 보인다.
    for id in ${FAKE_DOCKER_OLD_APP-app-old}; do echo "$id"; done
    if grep -q -- "--scale app=" "$FAKE_LOG"; then echo "${FAKE_DOCKER_NEW_APP:-app-new}"; fi ;;
  *"inspect -f"*)
    echo "${FAKE_DOCKER_NEW_HEALTH:-healthy}" ;;
  *"port proxy 80"*)
    echo "${FAKE_DOCKER_PORT:-127.0.0.1:8089}" ;;
  *"port app 5000"*)
    # proxy 전환 전 컨테이너만 호스트 포트를 가진다. 기본은 "없음"(진짜 docker 는 exit 1).
    if [ -n "${FAKE_DOCKER_APP_PORT:-}" ]; then echo "$FAKE_DOCKER_APP_PORT"; else exit 1; fi ;;
esac
exit 0
