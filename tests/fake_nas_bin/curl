#!/bin/sh
# 가짜 curl — 처음 FAKE_CURL_FAILS 번은 실패하고 그 뒤로 /health 응답을 준다.
printf 'curl %s\n' "$*" >> "$FAKE_LOG"

count=$(cat "$FAKE_CURL_COUNTER" 2>/dev/null || echo 0)
count=$((count + 1))
echo "$count" > "$FAKE_CURL_COUNTER"

if [ "$count" -le "${FAKE_CURL_FAILS:-0}" ]; then
  echo "fake curl: 아직 안 뜸" >&2
  exit 22
fi

echo '{"status":"ok"}'
exit 0
