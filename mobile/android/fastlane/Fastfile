# 사람이 맥에서 손으로 올릴 때 쓰는 lane 들. 자동 배포(main 푸시)는
# .github/workflows/flutter.yml 이 r0adkll/upload-google-play 로 한다.
default_platform(:android)

require "fileutils"
require "shellwords"

# 수동 lane 도 Actions 와 같은 값으로 빌드해야 한다 — 하나라도 빠지면 앱이
# 에뮬레이터 기본 주소(`mobile/lib/config/app_env.dart`)로 서버를 찾고, 광고·
# 로그인은 빈 ID 로 나간다. 값은 환경변수로 받는다(docs/RELEASE.md "34.").
REQUIRED_DEFINES = %w[
  API_BASE_URL
  GOOGLE_SERVER_CLIENT_ID
  ADMOB_BANNER_AD_UNIT_ID
  ADMOB_INTERSTITIAL_AD_UNIT_ID
  ADMOB_REWARDED_AD_UNIT_ID
].freeze

# 비어 있어도 되는 것(워크플로도 빈 값을 넘긴다 — 앱이 Sentry 를 초기화하지 않는다).
OPTIONAL_DEFINES = %w[SENTRY_DSN].freeze

def dart_defines
  missing = REQUIRED_DEFINES.reject { |name| ENV[name].to_s.strip != "" }
  unless missing.empty?
    UI.user_error!(
      "환경변수 #{missing.join(', ')} 가 비어 있다 — 잘못 설정된 바이너리가 " \
      "스토어로 가지 않게 빌드 전에 멈춘다 (docs/RELEASE.md \"34.\")"
    )
  end

  names = REQUIRED_DEFINES + OPTIONAL_DEFINES.select { |name| ENV[name].to_s != "" }
  names.map { |name| "--dart-define=#{name}=#{Shellwords.escape(ENV[name])}" }.join(" ")
end

AAB_PATH = "build/app/outputs/bundle/release/app-release.aab"

# Flutter 루트는 fastlane 기준 두 단계 위(mobile/)다.
def build_appbundle(clean:)
  defines = dart_defines
  Dir.chdir("../..") do
    if clean
      sh("flutter clean")
      sh("flutter pub get")
    end
    # 이전 실행이 남긴 AAB 를 먼저 지운다. `clean:` 은 선택이라 문서의 기본
    # 명령은 산출물을 그대로 두는데, 그 상태로 빌드가 실패하면 아래 존재 검사가
    # 지난 AAB 를 보고 통과해 다른 소스·다른 API 환경의 바이너리가 스토어로
    # 올라간다. 지우고 나면 "파일이 있다" = "이번 빌드가 만들었다" 가 된다.
    FileUtils.rm_f(AAB_PATH)
    # debugSymbolLevel=FULL 의 스트립 오탐으로 flutter tool 이 exit 1 을 주지만
    # AAB 는 정상 생성된다 — 종료 코드 대신 산출물로 성공을 판정한다
    # (워크플로의 AAB 스텝과 같은 이유, .github/workflows/flutter.yml).
    sh("flutter build appbundle --release #{defines} || echo 'flutter exited nonzero (known strip false-positive with debugSymbolLevel=FULL)'")
    UI.user_error!("AAB was not produced — 이번 빌드가 실패했다 (#{AAB_PATH})") unless File.exist?(AAB_PATH)
    # 종료 코드를 삼킨 만큼 산출물을 직접 검사한다(워크플로와 같은 스크립트).
    sh("python3 tool/verify_appbundle.py #{Shellwords.escape(AAB_PATH)}")
  end
end

platform :android do
  desc "Play 내부 테스트 트랙에 올린다 (초안)"
  lane :beta do |options|
    build_appbundle(clean: options[:clean])

    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: "fastlane/google-play-key.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
  end

  desc "Play 프로덕션에 올린다 (초안 — 출시 버튼은 사람)"
  lane :release do |options|
    build_appbundle(clean: options[:clean])

    # 메타데이터·스크린샷은 fastlane/metadata/ (티켓 35) 에서 올라간다.
    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: "fastlane/google-play-key.json",
      sync_image_upload: true,
      release_status: "draft"
    )
  end
end
