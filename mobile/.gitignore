# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase 설정 파일(프로젝트 식별자·API 키). `.example` 자리표시자만 커밋한다.
# 파일이 없으면 빌드·런타임 모두 Firebase 를 건너뛴다.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# flutter_native_splash / flutter_launcher_icons 가 생성하는 네이티브 자산은
# 커밋한다(CI 가 생성 단계를 돌지 않는다) — 여기엔 아무것도 더하지 않는다.

# 구글 로그인 iOS 클라이언트 ID. `.example` 자리표시자만 커밋한다.
/ios/Flutter/Secrets.xcconfig

# 골든 비교 실패 시 flutter_test 가 떨구는 이미지(로컬 산출물).
/test/golden/failures/
