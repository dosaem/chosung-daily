<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ko</string>
		</array>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Hidden Vowels</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<!-- AdMob 앱 ID(티켓 31). 없으면 SDK 초기화가 앱을 죽인다. 지금은
		     Google 테스트 앱 ID 이고 실제 ID 는 AdMob 콘솔에서 만든 뒤 바꾼다
		     (docs/RELEASE.md "### 31."). -->
		<key>GADApplicationIdentifier</key>
		<string>ca-app-pub-3940256099942544~1458002511</string>
		<!-- ATT 프롬프트 문구(영어 기본, 한국어는 ko.lproj/InfoPlist.strings).
		     이 키가 없으면 requestTrackingAuthorization 호출이 앱을 죽인다. -->
		<key>NSUserTrackingUsageDescription</key>
		<string>We use this to show ads that match your interests. The app works the same if you decline.</string>
		<key>CFBundleName</key>
		<string>Hidden Vowels</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- 구글 로그인(티켓 29). iOS 는 서버 aud 가 iOS 클라이언트 ID 라
		     serverClientId 를 쓰지 않고 여기 값을 쓴다(스펙 §A.6 표).
		     값은 ios/Flutter/Secrets.xcconfig 가 넣는다 — 콘솔 등록 전에는
		     비어 있고, 그러면 연결 버튼이 "로그인하지 못했어요" 로 떨어진다. -->
		<key>GIDClientID</key>
		<string>$(GOOGLE_IOS_CLIENT_ID)</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<!-- 역방향 클라이언트 ID(com.googleusercontent.apps.…) — 구글이
				     로그인 뒤 앱으로 돌아올 때 쓰는 스킴이다. -->
				<key>CFBundleURLSchemes</key>
				<array>
					<string>$(GOOGLE_IOS_URL_SCHEME)</string>
				</array>
			</dict>
		</array>
		<!-- 수출 규정(암호화) 신고. 이 앱이 쓰는 암호화는 **OS 가 제공하는 것**
		     뿐이다 — dio/URLSession 의 HTTPS 와 flutter_secure_storage 의
		     Keychain. 자체 암호 구현·암호 라이브러리(crypto·pointycastle·
		     encrypt 등)를 pubspec 에 넣지 않았다. 둘 다 Apple 의 면제 범주라
		     `false` 다(티켓 41, docs/RELEASE.md "### 41."). 이 키가 없으면
		     올라간 TestFlight 빌드가 전부 "Missing Compliance" 로 들어가
		     사람이 매 빌드 콘솔에서 답해야 심사 제출이 열린다.
		     자체 암호화를 들이면 이 값과 그 절을 같이 고친다. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
