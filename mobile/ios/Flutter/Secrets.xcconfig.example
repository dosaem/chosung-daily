// 구글 로그인(iOS)에 필요한 값. 이 파일을 `Secrets.xcconfig` 로 복사해 실제
// 값을 넣는다(gitignore 됨). Debug/Release.xcconfig 가 `#include?` 로 읽으므로
// 파일이 없어도 빌드는 되고, 대신 `Info.plist` 의 `GIDClientID` 가 비어
// 앱에서 구글 연결만 실패한다.
//
// 값은 Google Cloud 콘솔 > 사용자 인증 정보 > iOS 클라이언트에서 가져온다.
// 비밀값은 아니다(앱 번들에 그대로 들어간다) — 콘솔 등록 전이라 자리만 둔다.
//
// Android 의 serverClientId(= 웹 클라이언트 ID)는 여기가 아니라
// `--dart-define=GOOGLE_SERVER_CLIENT_ID` 다(docs/RELEASE.md "### 29.").

// 예) 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID =

// 위 값을 거꾸로 뒤집은 URL 스킴. 예) com.googleusercontent.apps.1234567890-abcdefg
// xcconfig 는 `//` 를 주석으로 보므로 값에 `//` 가 들어가면 안 된다(여긴 없다).
GOOGLE_IOS_URL_SCHEME =
